// ==========================================
// DISPLAY RECURRING EXPENSES
// ==========================================

function displayRecurringExpenses() {

    const container =
        el("recurringList");


    if (!container) return;


    if (
        recurringExpenses.length === 0
    ) {

        container.innerHTML = `

            <div class="empty-state">
                No recurring expenses.
            </div>

        `;

        return;

    }


    container.innerHTML = "";


    recurringExpenses.forEach(item => {

        const row =
            document.createElement(
                "div"
            );


        row.className =
            "recurring-row";


        row.innerHTML = `

            <div class="recurring-info">

                <h3>
                    ${safe(item.name)}
                </h3>

                <p>
                    ${safe(item.category)}
                    • Every month on day
                    ${item.day}
                </p>

            </div>

            <strong>
                ₹${money(item.amount)}
            </strong>

        `;


        container.appendChild(row);

    });

}


// ==========================================
// UPDATE DASHBOARD
// ==========================================

function updateDashboard() {

    const totalExpenses =
        expenses.reduce(
            (total, expense) =>
                total +
                Number(expense.amount || 0),
            0
        );


    const availableSavings =
        income -
        totalExpenses;


    const savingsRate =
        income > 0
            ? availableSavings /
              income *
              100
            : 0;


    if (el("totalIncome"))
        el("totalIncome").textContent =
            "₹" + money(income);


    if (el("totalExpenses"))
        el("totalExpenses").textContent =
            "₹" + money(totalExpenses);


    if (el("totalSavings"))
        el("totalSavings").textContent =
            "₹" + money(availableSavings);


    if (el("savingsRate"))
        el("savingsRate").textContent =
            savingsRate.toFixed(1) + "%";


    if (el("reportIncome"))
        el("reportIncome").textContent =
            "₹" + money(income);


    if (el("reportExpense"))
        el("reportExpense").textContent =
            "₹" + money(totalExpenses);


    if (el("reportSavings"))
        el("reportSavings").textContent =
            "₹" + money(availableSavings);


    calculateHighestCategory();

}


// ==========================================
// HIGHEST SPENDING CATEGORY
// ==========================================

function calculateHighestCategory() {

    const totals = {};


    expenses.forEach(expense => {

        const category =
            expense.category;

        if (!totals[category]) {

            totals[category] = 0;

        }


        totals[category] +=
            Number(expense.amount || 0);

    });


    let highest = "—";

    let highestAmount = 0;


    Object.keys(totals).forEach(category => {

        if (
            totals[category] >
            highestAmount
        ) {

            highestAmount =
                totals[category];

            highest =
                category +
                " - ₹" +
                money(highestAmount);

        }

    });


    if (el("highestCategory"))
        el("highestCategory").textContent =
            highest;

}


// ==========================================
// LOGOUT
// ==========================================

function logout() {

    localStorage.removeItem(
        "budgetLoggedUser"
    );


    currentUser = null;

    income = 0;

    expenses = [];

    goals = [];

    recurringExpenses = [];


    showLogin();

}


// ==========================================
// PASSWORD SHOW / HIDE
// ==========================================

function togglePassword(id) {

    const input = el(id);

    if (!input) return;


    if (input.type === "password") {

        input.type = "text";

    } else {

        input.type = "password";

    }

}


// ==========================================
// MONEY FORMAT
// ==========================================

function money(amount) {

    return Number(amount || 0)
        .toLocaleString(
            "en-IN",
            {
                maximumFractionDigits: 0
            }
        );

}


// ==========================================
// DATE FORMAT
// ==========================================

function dateFormat(date) {

    if (!date) return "";

    const d = new Date(date);

    if (isNaN(d.getTime())) return date;


    return d.toLocaleDateString(
        "en-IN",
        {
            day: "2-digit",
            month: "short",
            year: "numeric"
        }
    );

}


// ==========================================
// CATEGORY ICON
// ==========================================

function categoryIcon(category) {

    const icons = {

        Rent: "🏠",

        Food: "🍱",

        Transport: "🚌",

        Bills: "💡",

        Shopping: "🛍️",

        Health: "🏥",

        Entertainment: "🎬",

        Education: "📚",

        Other: "📌"

    };


    return icons[category] || "📌";

}


// ==========================================
// SAFE TEXT
// ==========================================

function safe(value) {

    return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


// ==========================================
// TODAY DATE
// ==========================================

function setTodayDate() {

    const input =
        el("expenseDate");


    if (
        input &&
        !input.value
    ) {

        input.value =
            new Date()
                .toISOString()
                .split("T")[0];

    }

}


// ==========================================
// DOWNLOAD REPORT
// ==========================================

function downloadReport() {

    if (!currentUser) {

        alert(
            "Please login first."
        );

        return;

    }


    const totalExpenses =
        expenses.reduce(
            (sum, expense) =>
                sum +
                Number(
                    expense.amount || 0
                ),
            0
        );


    const savings =
        income -
        totalExpenses;


    const savingsRate =
        income > 0
            ? savings / income * 100
            : 0;


    let report = "";


    report +=
        "BUDGET PLANNER PRO\n";

    report +=
        "============================\n\n";


    report +=
        "USER INFORMATION\n";

    report +=
        "----------------------------\n";


    report +=
        "Name: " +
        currentUser.name +
        "\n";


    report +=
        "Email: " +
        currentUser.email +
        "\n\n";


    report +=
        "MONTHLY SUMMARY\n";

    report +=
        "----------------------------\n";


    report +=
        "Income: ₹" +
        money(income) +
        "\n";


    report +=
        "Total Expenses: ₹" +
        money(totalExpenses) +
        "\n";


    report +=
        "Available Savings: ₹" +
        money(savings) +
        "\n";


    report +=
        "Savings Rate: " +
        savingsRate.toFixed(1) +
        "%\n\n";


    report +=
        "EXPENSE DETAILS\n";

    report +=
        "----------------------------\n";


    if (expenses.length === 0) {

        report +=
            "No expenses recorded.\n";

    } else {

        expenses.forEach(
            expense => {

                report +=
                    dateFormat(
                        expense.date
                    ) +
                    " | " +
                    expense.category +
                    " | " +
                    expense.description +
                    " | ₹" +
                    money(
                        expense.amount
                    ) +
                    "\n";

            }
        );

    }


    report += "\n";

    report +=
        "SAVINGS GOALS\n";

    report +=
        "----------------------------\n";


    if (goals.length === 0) {

        report +=
            "No savings goals.\n";

    } else {

        goals.forEach(goal => {

            report +=
                goal.name +
                " | Target: ₹" +
                money(goal.target) +
                " | Saved: ₹" +
                money(goal.saved) +
                "\n";

        });

    }


    report += "\n";

    report +=
        "RECURRING EXPENSES\n";

    report +=
        "----------------------------\n";


    if (
        recurringExpenses.length === 0
    ) {

        report +=
            "No recurring expenses.\n";

    } else {

        recurringExpenses.forEach(
            item => {

                report +=
                    item.name +
                    " | " +
                    item.category +
                    " | ₹" +
                    money(item.amount) +
                    " | Day " +
                    item.day +
                    "\n";

            }
        );

    }


    const blob =
        new Blob(
            [report],
            {
                type:
                    "text/plain;charset=utf-8"
            }
        );


    const url =
        URL.createObjectURL(blob);


    const link =
        document.createElement("a");


    link.href = url;

    link.download =
        "Budget-Planner-Report.txt";


    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);


    URL.revokeObjectURL(url);

}


