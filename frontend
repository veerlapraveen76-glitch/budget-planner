// ==========================================
// BUDGET PLANNER PRO - FRONTEND
// ==========================================

const API_URL = "http://localhost:5000/api";

let currentUser = null;
let income = 0;
let expenses = [];
let goals = [];
let recurringExpenses = [];


// ==========================================
// START APP
// ==========================================

document.addEventListener("DOMContentLoaded", () => {

    attachEvents();

    const savedUser =
        localStorage.getItem("budgetLoggedUser");

    if (savedUser) {

        try {

            currentUser = JSON.parse(savedUser);

            loadUserData();

            showDashboard();

        } catch (error) {

            console.error("Saved user error:", error);

            localStorage.removeItem("budgetLoggedUser");

            showLogin();

        }

    } else {

        showLogin();

    }

    setTodayDate();

});


// ==========================================
// GET ELEMENT
// ==========================================

function el(id) {
    return document.getElementById(id);
}


// ==========================================
// LOGIN / SIGNUP UI
// ==========================================

function showLogin() {

    if (el("authPage"))
        el("authPage").style.display = "flex";

    if (el("app"))
        el("app").style.display = "none";

    if (el("loginForm"))
        el("loginForm").style.display = "block";

    if (el("signupForm"))
        el("signupForm").style.display = "none";

    if (el("authTitle"))
        el("authTitle").textContent = "Welcome Back";

    if (el("switchText"))
        el("switchText").textContent =
            "Don't have an account?";

    if (el("switchAuth"))
        el("switchAuth").textContent =
            "Create Account";

    clearMessage();
}


function showSignup() {

    if (el("authPage"))
        el("authPage").style.display = "flex";

    if (el("app"))
        el("app").style.display = "none";

    if (el("loginForm"))
        el("loginForm").style.display = "none";

    if (el("signupForm"))
        el("signupForm").style.display = "block";

    if (el("authTitle"))
        el("authTitle").textContent =
            "Create Account";

    if (el("switchText"))
        el("switchText").textContent =
            "Already have an account?";

    if (el("switchAuth"))
        el("switchAuth").textContent =
            "Login";

    clearMessage();
}


// ==========================================
// MESSAGE
// ==========================================

function clearMessage() {

    const message = el("authMessage");

    if (!message) return;

    message.style.display = "none";
    message.textContent = "";

}


function showMessage(message) {

    const authMessage = el("authMessage");

    if (!authMessage) {

        alert(message);

        return;

    }

    authMessage.textContent = message;
    authMessage.style.display = "block";

}


// ==========================================
// ATTACH EVENTS
// ==========================================

function attachEvents() {

    const switchAuth = el("switchAuth");
    const signupForm = el("signupForm");
    const loginForm = el("loginForm");
    const logoutBtn = el("logoutBtn");
    const createBudgetBtn = el("createBudgetBtn");
    const expenseForm = el("expenseForm");
    const filterCategory = el("filterCategory");
    const goalForm = el("goalForm");
    const recurringForm = el("recurringForm");


    // Switch Login / Signup

    if (switchAuth) {

        switchAuth.addEventListener("click", (event) => {

            event.preventDefault();

            if (
                signupForm &&
                signupForm.style.display === "none"
            ) {

                showSignup();

            } else {

                showLogin();

            }

        });

    }


    // Signup

    if (signupForm) {

        signupForm.addEventListener(
            "submit",
            signup
        );

    }


    // Login

    if (loginForm) {

        loginForm.addEventListener(
            "submit",
            login
        );

    }


    // Logout

    if (logoutBtn) {

        logoutBtn.addEventListener(
            "click",
            logout
        );

    }


    // Create Budget

    if (createBudgetBtn) {

        createBudgetBtn.addEventListener(
            "click",
            createBudget
        );

    }


    // Expense

    if (expenseForm) {

        expenseForm.addEventListener(
            "submit",
            addExpense
        );

    }


    // Expense filter

    if (filterCategory) {

        filterCategory.addEventListener(
            "change",
            displayExpenses
        );

    }


    // Goals

    if (goalForm) {

        goalForm.addEventListener(
            "submit",
            addGoal
        );

    }


    // Recurring

    if (recurringForm) {

        recurringForm.addEventListener(
            "submit",
            addRecurring
        );

    }

}


// ==========================================
// SIGNUP
// ==========================================

async function signup(event) {

    event.preventDefault();

    const name =
        el("signupName")?.value.trim();

    const email =
        el("signupEmail")?.value
            .trim()
            .toLowerCase();

    const password =
        el("signupPassword")?.value;

    const confirmPassword =
        el("confirmPassword")?.value;


    if (
        !name ||
        !email ||
        !password ||
        !confirmPassword
    ) {

        showMessage(
            "Please fill all fields."
        );

        return;

    }


    if (password.length < 6) {

        showMessage(
            "Password must contain at least 6 characters."
        );

        return;

    }


    if (password !== confirmPassword) {

        showMessage(
            "Passwords do not match."
        );

        return;

    }


    try {

        const response =
            await fetch(
                `${API_URL}/register`,
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({

                        name: name,

                        email: email,

                        password: password

                    })

                }
            );


        const data =
            await response.json();


        if (!response.ok) {

            showMessage(
                data.message ||
                "Registration failed."
            );

            return;

        }


        showMessage(
            "Account created successfully!"
        );


        if (el("signupForm"))
            el("signupForm").reset();


        setTimeout(() => {

            showLogin();

            if (el("loginEmail"))
                el("loginEmail").value =
                    email;

        }, 800);


    } catch (error) {

        console.error(
            "Signup error:",
            error
        );

        showMessage(
            "Cannot connect to server. Make sure backend is running."
        );

    }

}


// ==========================================
// LOGIN
// ==========================================

async function login(event) {

    event.preventDefault();


    const email =
        el("loginEmail")?.value
            .trim()
            .toLowerCase();

    const password =
        el("loginPassword")?.value;


    if (!email || !password) {

        showMessage(
            "Please enter email and password."
        );

        return;

    }


    try {

        const response =
            await fetch(
                `${API_URL}/login`,
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({

                        email: email,

                        password: password

                    })

                }
            );


        const data =
            await response.json();


        if (!response.ok) {

            showMessage(
                data.message ||
                "Login failed."
            );

            return;

        }


        currentUser = data.user;


        localStorage.setItem(
            "budgetLoggedUser",
            JSON.stringify(currentUser)
        );


        loadUserData();

        showDashboard();


    } catch (error) {

        console.error(
            "Login error:",
            error
        );

        showMessage(
            "Cannot connect to server. Make sure backend is running."
        );

    }

}


// ==========================================
// SHOW DASHBOARD
// ==========================================

function showDashboard() {

    if (el("authPage"))
        el("authPage").style.display =
            "none";

    if (el("app"))
        el("app").style.display =
            "block";


    if (el("userName")) {

        el("userName").textContent =
            currentUser?.name ||
            "User";

    }

}


// ==========================================
// LOAD USER DATA
// ==========================================

function loadUserData() {

    if (!currentUser) return;


    income =
        Number(currentUser.income) || 0;


    expenses =
        Array.isArray(
            currentUser.expenses
        )
            ? currentUser.expenses
            : [];


    goals =
        Array.isArray(
            currentUser.goals
        )
            ? currentUser.goals
            : [];


    recurringExpenses =
        Array.isArray(
            currentUser.recurringExpenses
        )
            ? currentUser.recurringExpenses
            : [];


    if (el("salaryInput")) {

        el("salaryInput").value =
            income || "";

    }


    updateDashboard();

    displayExpenses();

    displayGoals();

    displayRecurringExpenses();


    if (income > 0) {

        generateBudget(income);

    }

}


// ==========================================
// SAVE USER DATA
// ==========================================

async function saveUserData() {

    if (!currentUser) return;


    currentUser.income =
        Number(income) || 0;

    currentUser.expenses =
        expenses;

    currentUser.goals =
        goals;

    currentUser.recurringExpenses =
        recurringExpenses;


    // Local backup

    localStorage.setItem(
        "budgetLoggedUser",
        JSON.stringify(currentUser)
    );


    try {

        const response =
            await fetch(
                `${API_URL}/user/${currentUser.id}`,
                {
                    method: "PUT",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({

                        income: income,

                        expenses: expenses,

                        goals: goals,

                        recurringExpenses:
                            recurringExpenses

                    })

                }
            );


        if (!response.ok) {

            console.warn(
                "Backend data save failed."
            );

        }

    } catch (error) {

        console.warn(
            "Could not save data to backend:",
            error
        );

    }

}


// ==========================================
// CREATE BUDGET
// ==========================================

function createBudget() {

    const salary =
        Number(
            el("salaryInput")?.value
        );


    if (!salary || salary <= 0) {

        alert(
            "Please enter a valid monthly income."
        );

        return;

    }


    income = salary;


    saveUserData();


    generateBudget(salary);

    updateDashboard();


    alert(
        "Your smart budget has been created successfully!"
    );

}


// ==========================================
// SMART BUDGET
// ==========================================

function generateBudget(salary) {

    const recommendations = [

        ["🏠 Rent / PG", 20],

        ["🍱 Food", 12],

        ["🚌 Transport", 6],

        ["💡 Bills", 5],

        ["🛍️ Shopping", 6],

        ["🏥 Health", 3],

        ["🎬 Entertainment", 4],

        ["📚 Education", 4],

        ["🛟 Emergency Fund", 8],

        ["💰 Savings", 32]

    ];


    const container =
        el("budgetRecommendations");


    if (!container) return;


    container.innerHTML = "";


    recommendations.forEach(
        ([name, percentage]) => {

            const amount =
                salary *
                percentage /
                100;


            const card =
                document.createElement(
                    "div"
                );


            card.className =
                "budget-item";


            card.innerHTML = `

                <h3>${name}</h3>

                <p>
                    Recommended allocation:
                    ${percentage}%
                </p>

                <div class="budget-amount">
                    ₹${money(amount)}
                </div>

                <div class="progress">

                    <div
                        class="progress-bar"
                        style="width:${percentage}%">
                    </div>

                </div>

            `;


            container.appendChild(card);

        }
    );

}


// ==========================================
// ADD EXPENSE
// ==========================================

function addExpense(event) {

    event.preventDefault();


    const amount =
        Number(
            el("expenseAmount")?.value
        );


    const category =
        el("expenseCategory")?.value;


    const description =
        el("expenseDescription")
            ?.value
            .trim();


    const date =
        el("expenseDate")?.value;


    if (
        !amount ||
        amount <= 0 ||
        !category ||
        !description ||
        !date
    ) {

        alert(
            "Please fill all expense details."
        );

        return;

    }


    expenses.push({

        id: Date.now(),

        amount: amount,

        category: category,

        description: description,

        date: date

    });


    saveUserData();

    updateDashboard();

    displayExpenses();


    if (el("expenseForm"))
        el("expenseForm").reset();


    setTodayDate();

}


// ==========================================
// DISPLAY EXPENSES
// ==========================================

function displayExpenses() {

    const container =
        el("expenseList");


    if (!container) return;


    const filter =
        el("filterCategory")?.value ||
        "All";


    let list = expenses;


    if (filter !== "All") {

        list =
            expenses.filter(
                expense =>
                    expense.category ===
                    filter
            );

    }


    if (list.length === 0) {

        container.innerHTML = `

            <div class="empty-state">
                No expenses found.
            </div>

        `;

        return;

    }


    container.innerHTML = "";


    list
        .slice()
        .reverse()
        .forEach(expense => {

            const row =
                document.createElement(
                    "div"
                );


            row.className =
                "expense-row";


            row.innerHTML = `

                <div class="expense-icon">
                    ${categoryIcon(
                        expense.category
                    )}
                </div>

                <div class="expense-info">

                    <h3>
                        ${safe(
                            expense.description
                        )}
                    </h3>

                    <p>
                        ${safe(
                            expense.category
                        )}
                        •
                        ${dateFormat(
                            expense.date
                        )}
                    </p>

                </div>

                <div class="expense-amount">
                    - ₹${money(
                        expense.amount
                    )}
                </div>

                <button
                    class="delete-btn"
                    onclick="deleteExpense(${expense.id})">

                    Delete

                </button>

            `;


            container.appendChild(row);

        });

}


// ==========================================
// DELETE EXPENSE
// ==========================================

function deleteExpense(id) {

    if (
        !confirm(
            "Are you sure you want to delete this expense?"
        )
    ) {

        return;

    }


    expenses =
        expenses.filter(
            expense =>
                expense.id !== id
        );


    saveUserData();

    updateDashboard();

    displayExpenses();

}


// ==========================================
// ADD SAVINGS GOAL
// ==========================================

function addGoal(event) {

    event.preventDefault();


    const name =
        el("goalName")
            ?.value
            .trim();


    const target =
        Number(
            el("goalTarget")?.value
        );


    if (
        !name ||
        !target ||
        target <= 0
    ) {

        alert(
            "Please enter a valid goal."
        );

        return;

    }


    goals.push({

        id: Date.now(),

        name: name,

        target: target,

        saved: 0

    });


    saveUserData();

    displayGoals();


    if (el("goalForm"))
        el("goalForm").reset();

}


// ==========================================
// DISPLAY GOALS
// ==========================================

function displayGoals() {

    const container =
        el("goalList");


    if (!container) return;


    if (goals.length === 0) {

        container.innerHTML = `

            <div class="empty-state">
                No savings goals yet.
            </div>

        `;

        return;

    }


    container.innerHTML = "";


    goals.forEach(goal => {

        const target =
            Number(goal.target) || 0;

        const saved =
            Number(goal.saved) || 0;


        const percentage =
            target > 0
                ? Math.min(
                    saved / target * 100,
                    100
                )
                : 0;


        const card =
            document.createElement(
                "div"
            );


        card.className =
            "goal-card";


        card.innerHTML = `

            <div class="goal-header">

                <h3>
                    🎯 ${safe(goal.name)}
                </h3>

                <span>
                    ${percentage.toFixed(0)}%
                </span>

            </div>

            <div class="progress">

                <div
                    class="progress-bar"
                    style="width:${percentage}%">
                </div>

            </div>

            <div class="goal-info">

                ₹${money(saved)}
                saved of
                ₹${money(target)}

            </div>

        `;


        container.appendChild(card);

    });

}


// ==========================================
// ADD RECURRING EXPENSE
// ==========================================

function addRecurring(event) {

    event.preventDefault();


    const name =
        el("recurringName")
            ?.value
            .trim();


